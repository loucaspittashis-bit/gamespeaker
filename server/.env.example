# Copy to .env and fill in. Run scripts/gen-secrets.sh to fill the secrets and the admin password.

# Your domain, without https:// (for example yourname.duckdns.org)
DOMAIN=yourname.duckdns.org

# Name shown in the app
SERVER_NAME=Gamespeaker

# The one password your friends type in. Changing it signs everyone out.
SERVER_PASSWORD=change-me-to-something-long

# Unlocks Settings > Server admin in the app (channels, server name, password, kick and ban).
# Keep it to yourself. Leave empty and gen-secrets.sh makes one; delete the line to turn admin off.
ADMIN_PASSWORD=

# Generated secrets: never share these
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SESSION_SECRET=
